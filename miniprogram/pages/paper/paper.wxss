.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: #edf1e8;
}

.topbar {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
}

.back-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #285a43;
  font-size: 25rpx;
  font-weight: 700;
}

.back-arrow {
  font-size: 34rpx;
  font-weight: 400;
}

.page-date {
  color: #707a6e;
  font-size: 23rpx;
}

.intro {
  display: flex;
  flex-direction: column;
  padding: 36rpx 0 22rpx;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #d8774c;
  font-size: 19rpx;
  font-weight: 700;
}

.page-title {
  color: #202c24;
  font-family: serif;
  font-size: 48rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 10rpx;
  color: #707a6e;
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin: 8rpx 0 20rpx;
}

.action-button {
  flex: 1;
  height: 76rpx;
  margin: 0;
  border: 1rpx solid #285a43;
  border-radius: 6rpx;
  font-size: 25rpx;
  line-height: 74rpx;
}

.answer-button {
  color: #fff;
  background: #285a43;
}

.export-button {
  color: #fff;
  background: #d8774c;
  border-color: #d8774c;
}

.paper-sheet {
  padding: 28rpx 24rpx 32rpx;
  background: #fbfaf5;
  border-top: 6rpx solid #edc65e;
  box-shadow: 0 10rpx 36rpx rgba(35, 53, 39, .08);
}

.student-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0 20rpx;
  color: #525c53;
  border-bottom: 1rpx solid #d9dfd4;
  font-size: 23rpx;
}

.question-section {
  margin-top: 28rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  color: #202c24;
  border-bottom: 1rpx solid #d9dfd4;
  font-family: serif;
  font-size: 29rpx;
  font-weight: 600;
}

.section-count {
  color: #707a6e;
  font-family: sans-serif;
  font-size: 21rpx;
  font-weight: 400;
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 12rpx;
  row-gap: 12rpx;
}

.question {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 5rpx;
  color: #202c24;
  font-family: serif;
  font-size: 23rpx;
  line-height: 1.65;
  white-space: nowrap;
}

.question-number {
  color: #d8774c;
  font-family: sans-serif;
  font-size: 20rpx;
}

.answers {
  margin-top: 32rpx;
  padding: 20rpx;
  background: #eef3e9;
  border-left: 6rpx solid #285a43;
}

.answer-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6rpx 8rpx;
  color: #435348;
  font-size: 18rpx;
  line-height: 1.2;
}

.paper-footer {
  margin-top: 32rpx;
  padding-top: 18rpx;
  color: #879087;
  border-top: 1rpx dashed #d9dfd4;
  font-size: 20rpx;
  text-align: center;
}
